{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notebook portable manifest — provisional schema version 1",
  "description": "Reconstructed from Document Model Specification V0.2; technical validation only, not a frozen production contract.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "pages",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pageReference"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "vec6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "$ref": "#/$defs/positive"
        },
        "height": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "pageReference": {
      "type": "object",
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "path": {
          "type": "string",
          "pattern": "^pages/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.json$"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "mimeType",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9a-fA-F]{64}\\.(png|jpg|pdf)$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "application/pdf"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "size",
        "background",
        "elements"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "$ref": "#/$defs/positive"
            },
            "height": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "background": {
      "oneOf": [
        {
          "$ref": "#/$defs/blankBackground"
        },
        {
          "$ref": "#/$defs/patternBackground"
        },
        {
          "$ref": "#/$defs/pdfBackground"
        }
      ]
    },
    "blankBackground": {
      "type": "object",
      "required": [
        "type",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "blank"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "patternBackground": {
      "type": "object",
      "required": [
        "type",
        "color",
        "patternColor",
        "spacing"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ruled",
            "grid",
            "dotted"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "patternColor": {
          "$ref": "#/$defs/color"
        },
        "spacing": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "pdfBackground": {
      "type": "object",
      "required": [
        "type",
        "assetId",
        "pageIndex",
        "displayBox"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pdfPage"
        },
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "displayBox": {
          "const": "crop"
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/strokeElement"
        },
        {
          "$ref": "#/$defs/shapeElement"
        },
        {
          "$ref": "#/$defs/textElement"
        },
        {
          "$ref": "#/$defs/imageElement"
        }
      ]
    },
    "strokeElement": {
      "$ref": "#/$defs/elementEnvelopeStroke"
    },
    "shapeElement": {
      "$ref": "#/$defs/elementEnvelopeShape"
    },
    "textElement": {
      "$ref": "#/$defs/elementEnvelopeText"
    },
    "imageElement": {
      "$ref": "#/$defs/elementEnvelopeImage"
    },
    "brush": {
      "type": "object",
      "required": [
        "kind",
        "width",
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pen",
            "pencil",
            "highlighter"
          ]
        },
        "width": {
          "$ref": "#/$defs/positive"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "strokePoint": {
      "type": "object",
      "required": [
        "x",
        "y",
        "tMs"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "tMs": {
          "type": "integer",
          "minimum": 0
        },
        "pressure": {
          "$ref": "#/$defs/unit"
        },
        "tiltRad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5707963267948966
        },
        "orientationRad": {
          "type": "number"
        }
      }
    },
    "strokePayload": {
      "type": "object",
      "required": [
        "encoding",
        "brush",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "const": "sampledPointsV1"
        },
        "brush": {
          "$ref": "#/$defs/brush"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strokePoint"
          }
        }
      }
    },
    "paint": {
      "type": "object",
      "required": [
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "lineStyle": {
      "type": "object",
      "required": [
        "color",
        "width",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "width": {
          "$ref": "#/$defs/positive"
        },
        "opacity": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "lineGeometry": {
      "type": "object",
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "additionalProperties": false,
      "properties": {
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "x2": {
          "type": "number"
        },
        "y2": {
          "type": "number"
        }
      }
    },
    "shapeFrame": {
      "$ref": "#/$defs/frame"
    },
    "arrowHead": {
      "type": "object",
      "required": [
        "length",
        "angleDeg"
      ],
      "additionalProperties": false,
      "properties": {
        "length": {
          "$ref": "#/$defs/positive"
        },
        "angleDeg": {
          "type": "number"
        }
      }
    },
    "shapePayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/lineShape"
        },
        {
          "$ref": "#/$defs/arrowShape"
        },
        {
          "$ref": "#/$defs/filledShape"
        }
      ]
    },
    "lineShape": {
      "type": "object",
      "required": [
        "kind",
        "geometry",
        "stroke",
        "fill"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "line"
        },
        "geometry": {
          "$ref": "#/$defs/lineGeometry"
        },
        "stroke": {
          "$ref": "#/$defs/lineStyle"
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/paint"
            }
          ]
        }
      }
    },
    "arrowShape": {
      "type": "object",
      "required": [
        "kind",
        "geometry",
        "stroke",
        "fill",
        "arrowHead"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "arrow"
        },
        "geometry": {
          "$ref": "#/$defs/lineGeometry"
        },
        "stroke": {
          "$ref": "#/$defs/lineStyle"
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/paint"
            }
          ]
        },
        "arrowHead": {
          "$ref": "#/$defs/arrowHead"
        }
      }
    },
    "filledShape": {
      "type": "object",
      "required": [
        "kind",
        "geometry",
        "stroke",
        "fill"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rectangle",
            "ellipse"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/frame"
        },
        "stroke": {
          "$ref": "#/$defs/lineStyle"
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/paint"
            }
          ]
        }
      }
    },
    "textStyle": {
      "type": "object",
      "required": [
        "fontFamily",
        "fontSize",
        "color",
        "bold",
        "italic",
        "underline",
        "alignment"
      ],
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "enum": [
            "sans",
            "serif",
            "mono"
          ]
        },
        "fontSize": {
          "$ref": "#/$defs/positive"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        }
      }
    },
    "textPayload": {
      "type": "object",
      "required": [
        "text",
        "frame",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "style": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "crop": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/unit"
        },
        "y": {
          "$ref": "#/$defs/unit"
        },
        "width": {
          "$ref": "#/$defs/unit"
        },
        "height": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "imagePayload": {
      "type": "object",
      "required": [
        "assetId",
        "frame",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "opacity": {
          "$ref": "#/$defs/unit"
        },
        "crop": {
          "$ref": "#/$defs/crop"
        }
      }
    },
    "elementEnvelopeStroke": {
      "type": "object",
      "required": [
        "id",
        "type",
        "transform",
        "locked",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "stroke"
        },
        "transform": {
          "$ref": "#/$defs/vec6"
        },
        "locked": {
          "type": "boolean"
        },
        "payload": {
          "$ref": "#/$defs/strokePayload"
        }
      }
    },
    "elementEnvelopeShape": {
      "type": "object",
      "required": [
        "id",
        "type",
        "transform",
        "locked",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "shape"
        },
        "transform": {
          "$ref": "#/$defs/vec6"
        },
        "locked": {
          "type": "boolean"
        },
        "payload": {
          "$ref": "#/$defs/shapePayload"
        }
      }
    },
    "elementEnvelopeText": {
      "type": "object",
      "required": [
        "id",
        "type",
        "transform",
        "locked",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "text"
        },
        "transform": {
          "$ref": "#/$defs/vec6"
        },
        "locked": {
          "type": "boolean"
        },
        "payload": {
          "$ref": "#/$defs/textPayload"
        }
      }
    },
    "elementEnvelopeImage": {
      "type": "object",
      "required": [
        "id",
        "type",
        "transform",
        "locked",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "image"
        },
        "transform": {
          "$ref": "#/$defs/vec6"
        },
        "locked": {
          "type": "boolean"
        },
        "payload": {
          "$ref": "#/$defs/imagePayload"
        }
      }
    }
  }
}
