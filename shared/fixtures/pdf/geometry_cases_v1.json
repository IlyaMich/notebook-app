{
  "contract": "pdf-page-geometry-v1",
  "description": "Synthetic PDF default-user-space to canonical page-space vectors. Expected values are reviewed constants, not generated by the implementation under test.",
  "validCases": [
    {
      "id": "crop-r0",
      "mediaBox": [0, 0, 300, 400],
      "cropBox": [20, 30, 220, 330],
      "rotate": 0,
      "userUnit": 1,
      "expectedCropBox": [20, 30, 220, 330],
      "expectedPageSize": [200, 300],
      "points": [
        {"source": [20, 30], "canonical": [0, 300]},
        {"source": [220, 330], "canonical": [200, 0]},
        {"source": [80, 100], "canonical": [60, 230]}
      ]
    },
    {
      "id": "crop-r90",
      "mediaBox": [0, 0, 300, 400],
      "cropBox": [20, 30, 220, 330],
      "rotate": 90,
      "userUnit": 1,
      "expectedCropBox": [20, 30, 220, 330],
      "expectedPageSize": [300, 200],
      "points": [
        {"source": [20, 30], "canonical": [0, 0]},
        {"source": [220, 330], "canonical": [300, 200]},
        {"source": [80, 100], "canonical": [70, 60]}
      ]
    },
    {
      "id": "crop-r180",
      "mediaBox": [0, 0, 300, 400],
      "cropBox": [20, 30, 220, 330],
      "rotate": 180,
      "userUnit": 1,
      "expectedCropBox": [20, 30, 220, 330],
      "expectedPageSize": [200, 300],
      "points": [
        {"source": [20, 30], "canonical": [200, 0]},
        {"source": [220, 330], "canonical": [0, 300]},
        {"source": [80, 100], "canonical": [140, 70]}
      ]
    },
    {
      "id": "crop-r270",
      "mediaBox": [0, 0, 300, 400],
      "cropBox": [20, 30, 220, 330],
      "rotate": 270,
      "userUnit": 1,
      "expectedCropBox": [20, 30, 220, 330],
      "expectedPageSize": [300, 200],
      "points": [
        {"source": [20, 30], "canonical": [300, 200]},
        {"source": [220, 330], "canonical": [0, 0]},
        {"source": [80, 100], "canonical": [230, 140]}
      ]
    },
    {
      "id": "missing-crop-letter-portrait",
      "mediaBox": [0, 0, 612, 792],
      "rotate": 0,
      "userUnit": 1,
      "expectedCropBox": [0, 0, 612, 792],
      "expectedPageSize": [612, 792],
      "points": [
        {"source": [0, 0], "canonical": [0, 792]},
        {"source": [612, 792], "canonical": [612, 0]},
        {"source": [123, 456], "canonical": [123, 336]}
      ]
    },
    {
      "id": "negative-origin-userunit-2",
      "mediaBox": [-100, -200, 400, 300],
      "cropBox": [-40, -80, 160, 220],
      "rotate": 90,
      "userUnit": 2,
      "expectedCropBox": [-40, -80, 160, 220],
      "expectedPageSize": [600, 400],
      "points": [
        {"source": [-40, -80], "canonical": [0, 0]},
        {"source": [160, 220], "canonical": [600, 400]},
        {"source": [-10, 20], "canonical": [200, 60]}
      ]
    },
    {
      "id": "crop-intersected-with-media",
      "mediaBox": [0, 0, 200, 200],
      "cropBox": [-20, 50, 150, 250],
      "rotate": 270,
      "userUnit": 1,
      "expectedCropBox": [0, 50, 150, 200],
      "expectedPageSize": [150, 150],
      "points": [
        {"source": [0, 50], "canonical": [150, 150]},
        {"source": [150, 200], "canonical": [0, 0]},
        {"source": [20, 100], "canonical": [100, 130]}
      ]
    },
    {
      "id": "fractional-crop-r180-userunit-1_5",
      "mediaBox": [0, -10, 200, 100],
      "cropBox": [10.25, -2.5, 110.75, 60.125],
      "rotate": 180,
      "userUnit": 1.5,
      "expectedCropBox": [10.25, -2.5, 110.75, 60.125],
      "expectedPageSize": [150.75, 93.9375],
      "points": [
        {"source": [10.25, -2.5], "canonical": [150.75, 0]},
        {"source": [110.75, 60.125], "canonical": [0, 93.9375]},
        {"source": [20.75, 7.5], "canonical": [135, 15]}
      ]
    }
  ],
  "invalidCases": [
    {"id": "zero-width-media", "mediaBox": [0, 0, 0, 100], "rotate": 0, "userUnit": 1},
    {"id": "empty-crop-intersection", "mediaBox": [0, 0, 100, 100], "cropBox": [200, 200, 300, 300], "rotate": 0, "userUnit": 1},
    {"id": "non-quarter-rotation", "mediaBox": [0, 0, 100, 100], "rotate": 45, "userUnit": 1},
    {"id": "zero-userunit", "mediaBox": [0, 0, 100, 100], "rotate": 0, "userUnit": 0}
  ]
}
