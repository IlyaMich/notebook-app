<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- All three activities are evaluation-only and absent from release builds. -->
        <activity
            android:name="com.notebook.app.ui.editor.ink.InkProbeActivity"
            android:exported="true"
            android:label="Notebook Ink Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.notebook.app.ui.editor.ink.InkPersistenceDemoActivity"
            android:exported="true"
            android:label="Notebook Room Ink Demo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.notebook.app.ui.editor.ink.InkGestureArbitrationActivity"
            android:exported="true"
            android:label="Notebook Ink Gestures">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
